__pycache__/
*.pyc
.DS_Store

# Regenerable pipeline caches and debug renders (see scripts/detect_canopy.py).
# data/osm_cache IS committed on purpose — small JSON, and it makes the ground
# bake reproducible without depending on Overpass being up.
data/imagery_cache/
data/canopy_debug_*.png
# Contact sheets from `python scripts/probe_roofs.py --sheet` — how the roof
# threshold gets checked against the actual photograph. Regenerable, and large.
data/roof_band_*.png
# The stitched Capitol Complex nadir reference (scripts/fetch_capitol_aerial.py).
# Reference input to a bake, never shipped; at --zoom 20 it is 120 MB, and the
# tiles it is stitched from are already cached under data/imagery_cache.
data/capitol_aerial.png
# Same deal for the DKR nadir reference — 7.3 MB, and it is the input the
# stadium bake's luma measurements were read off (see scripts/bake_stadium.py),
# not something the site ever loads.
data/dkr_aerial.png
scripts/_overpass_probe.json

# Local dev tooling (launch.json for the preview server, agent worktrees).
.claude/

# Verification renders are regenerable (scripts/verify/shot.mjs); the ones that
# document a change live in docs/shots/ as JPEGs instead.
scripts/verify/shots/
scripts/verify/node_modules/

# The raw Overture pull for the outer ring (scripts/extract_outer.py): 19.7 MB
# of intermediate that scripts/bake_outer.py turns into a 2.4 MB render file.
# Regenerable in ~6 minutes and pinned by data/outer/outer_source.json, which
# records the exact release it came from and IS committed.
data/outer/outer_raw.geojson

# The georeferenced DKR nadir is 15 MB and scripts/fetch_dkr_reference.py
# regenerates it deterministically from the sidecar's own bbox. The sidecar
# (data/dkr_aerial_geo.json) IS committed — it carries the exact bbox and
# metres-per-pixel that every measurement in docs/PASS_DKR.md was taken with.
data/dkr_aerial_geo.png

# Captures written by scripts/verify/outer-facade-parity.mjs for its Python
# comparator. Regenerated on every run; the assertion is the exit code.
scripts/verify/out/

# Secrets and web-tool scratch. The repo is PUBLIC — an API key committed here
# is an API key published. Firecrawl's CLI keeps its own key in its user config;
# nothing under here should ever carry one.
.env
.env.*
!.env.example
.firecrawl/

# A stderr dump left behind by an old `python scripts/serve.py` run. It was
# tracked at the repository root at 860 KB, read by nothing (grepped: the only
# mention anywhere is the HANDOFF note that found it). The server writes it only
# when its output is redirected there by hand, so it can come back the same way.
_serve.log
