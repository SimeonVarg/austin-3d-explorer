    "wallplane.mjs": "red on main, no browser needed, same on the laptop: 'WALLPLANE 1 FAILED', the GDC atrium's outer face is 5.23 m proud of the brick body",
    "geomlint.mjs": "red on main, no browser needed, same on the laptop: 60 sliver rings in the data (westcampus.geojson 78 issues, e.g. Cambridge Tower)",
    "suite-lint.mjs": "red on main, no browser needed, same on the laptop: 9 blocking findings (scripts that drive the map without cancelGraphicsAutoDetect, e.g. smear2.mjs)",
    "coplanar.mjs": "red on main, no browser needed, same on the laptop: --gate REGRESSED heroes.geojson 1 -> 1376 and outer_ring.geojson 179 -> 2101 against the 2026-08-24 baseline",
    "facadegrid.mjs": "cannot score on main (exit 2): 'only 1 template grid(s) were testable. This self-check has decayed to the point of proving nothing'",
    "mobile-mergecells.mjs": "cannot run on main (exit 2): 'APARTMENTS.mergeCells is not defined in this build', the switch it compares is gone"
  },
