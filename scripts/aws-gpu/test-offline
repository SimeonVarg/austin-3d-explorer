#!/usr/bin/env bash
#
# test-offline — the checks that run with no AWS account and no network.
#
#   1. bash -n on every script here (syntax only, nothing executes).
#   2. launch --print, asserting the guardrails are all present:
#        - instance-initiated-shutdown-behavior terminate
#        - project=flyover tag on the instance AND the volume
#        - the default type is g6.2xlarge and the fallback is g5.2xlarge
#        - the hard max runtime and idle timeout reach the user-data
#   3. teardown --print, asserting it targets only project=flyover and
#      terminates rather than deletes volumes.
#   4. the two IAM policy files parse as JSON.
#
# Run it: ./test-offline   (exit 0 = all passed)
#
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
FAILED=0
pass() { echo "  ok   $1"; }
fail() { echo "  FAIL $1"; FAILED=1; }

echo "== bash -n on every script =="
for f in launch user-data teardown test-offline; do
  if bash -n "$HERE/$f"; then pass "$f parses"; else fail "$f has a syntax error"; fi
done

echo "== launch --print guardrail assertions =="
OUT="$("$HERE/launch" --print 2>&1)" || { echo "$OUT"; fail "launch --print exited non-zero"; }

assert_has() {
  if echo "$OUT" | grep -qF "$1"; then pass "$2"; else fail "$2 (missing: $1)"; fi
}

assert_has "instance-initiated-shutdown-behavior terminate" "shutdown behaviour is terminate"
assert_has "g6.2xlarge" "default instance type is g6.2xlarge"
assert_has "g5.2xlarge" "fallback instance type is g5.2xlarge"
assert_has "ResourceType=instance,Tags=[{Key=project,Value=flyover}" "instance is tagged project=flyover"
assert_has "ResourceType=volume,Tags=[{Key=project,Value=flyover}" "volumes are tagged project=flyover"
assert_has "DeleteOnTermination=true" "root volume deletes on termination"

# The default type must literally BE g6.2xlarge, not just appear somewhere: the
# first run-instances line must carry it.
FIRST_RUN="$(echo "$OUT" | grep -m1 "instance-type g6.2xlarge")"
if [ -n "$FIRST_RUN" ]; then pass "first launch uses g6.2xlarge"; else fail "first launch does not use g6.2xlarge"; fi
SECOND_RUN="$(echo "$OUT" | grep -m1 "instance-type g5.2xlarge")"
if [ -n "$SECOND_RUN" ]; then pass "fallback launch uses g5.2xlarge"; else fail "fallback launch does not use g5.2xlarge"; fi

# The SSM AMI resolution must be present and flagged for verification.
assert_has "ssm get-parameter" "resolves the AMI from SSM"
grep -q "verify parameter name on first run" "$HERE/launch" && pass "SSM parameter marked verify-on-first-run" || fail "SSM parameter not marked verify-on-first-run"

echo "== user-data guardrail assertions =="
UD="$HERE/user-data"
grep -q 'shutdown -h "+' "$UD" && pass "user-data arms hard max-runtime shutdown" || fail "no hard max-runtime shutdown in user-data"
grep -q "idle watchdog" "$UD" && pass "user-data has an idle watchdog" || fail "no idle watchdog in user-data"
grep -qi "swiftshader" "$UD" && pass "user-data gates on SwiftShader" || fail "user-data does not check the renderer"
grep -q "VERIFY_GL=hardware" "$UD" && pass "user-data points harness at hardware GL" || fail "user-data missing VERIFY_GL=hardware"
grep -q "serve.py" "$UD" && pass "user-data serves with scripts/serve.py" || fail "user-data does not use serve.py"

echo "== check names are one flat, safe, unique folder each =="
# Run 38122495368: `--out /opt/flyover/out/guard` put slashes in the name, the output nested, and the manifest
# recorded a null exit for a check that had passed.
CJ="$("$HERE/launch" --print-checks --check "guard.mjs --out /opt/flyover/out/guard" --check "guard.mjs --out /opt/flyover/out/guard" \
      --check 'x.mjs --q a=1,b:2|c*?' --check "graphics.mjs" 2>&1)"
if printf '%s' "$CJ" | python3 -c '
import json, re, sys
c = json.load(sys.stdin); names = [x["name"] for x in c]
assert len(c) == 4, c
assert all(re.fullmatch(r"[A-Za-z0-9._-]{1,80}", n) for n in names), names
assert len(set(names)) == 4, names
assert names[0] == "guard_out_opt_flyover_out_guard" and names[1] == names[0] + "-2", names
assert names[3] == "graphics", names
assert c[0]["cmd"] == "guard.mjs" and c[0]["args"] == ["--out", "/opt/flyover/out/guard"], c[0]
assert c[2]["args"] == ["--q", "a=1,b:2|c*?"], c[2]
'; then pass "four checks: flat names, no slash or odd character, the twin gets -2, arguments unchanged"; else fail "check names: $CJ"; fi

echo "== the filled machine script carries every argument unchanged =="
# Run 38129844212: `--query smooth=0&packmerge=1` reached the machine as `smooth=0@@CHECKS_JSON@@packmerge=1`.
# This fills the real template, then runs the machine's OWN decode lines and its OWN args_of on the result.
RT_A='x.mjs --query smooth=0&packmerge=1'
RT_B='y.mjs --a back\slash --b "dq" --c it'"'"'s --d $HOME --e * --f a|b --g ;rm --h `id` --i @@REF@@'
RUD="$("$HERE/launch" --print-user-data --check "$RT_A" --check "$RT_B" 2>&1)" || fail "launch --print-user-data exited non-zero: $(printf '%s' "$RUD" | tail -1)"
RT_TMP="$(mktemp -d)"
printf '%s\n' "$RUD" > "$RT_TMP/user-data"
if python3 - "$RT_TMP" "$RT_A" "$RT_B" <<'PY'
import json, re, subprocess, sys, os
d, a, b = sys.argv[1], sys.argv[2], sys.argv[3]
s = open(os.path.join(d, 'user-data')).read()
head = s.split("CHECKS_JSON_B64='", 1)[0]
assert not re.findall(r'@@[A-Z0-9_]+@@', head + s.split('\nCHECKS_JSON="$(', 1)[1]), 'a token was left unfilled'
lines = [l for l in s.split('\n') if l.startswith('CHECKS_JSON_B64=') or l.startswith('CHECKS_JSON="$(')]
assert len(lines) == 2, lines
fn = re.search(r'^args_of\(\) \{\n.*?^\}\n', s, re.S | re.M).group(0)
script = 'set -euo pipefail\n' + '\n'.join(lines) + '\n' + fn + 'printf "%s" "$CHECKS_JSON"; printf "\\1"; args_of 0; printf "\\1"; args_of 1\n'
out = subprocess.run(['bash', '-c', script], capture_output=True, check=True, cwd=d).stdout
js, a0, a1 = out.split(b'\x01')
checks = json.loads(js)
want0, want1 = a.split()[1:], b.split()[1:]
got0 = [x.decode() for x in a0.split(b'\0')[:-1]]; got1 = [x.decode() for x in a1.split(b'\0')[:-1]]
assert checks[0]['args'] == want0 and checks[1]['args'] == want1, checks
assert got0 == want0, (got0, want0)
assert got1 == want1, (got1, want1)
assert got0 == ['--query', 'smooth=0&packmerge=1']
assert not os.path.exists(os.path.join(d, 'pwned'))
PY
then pass "ampersand, backslash, both quotes, dollar, star, pipe, semicolon, backtick and a token look-alike all arrive unchanged"; else fail "the filled machine script changed an argument"; fi
rm -rf "$RT_TMP"
if "$HERE/launch" --print-user-data --ref 'main"; touch pwned; "' >/dev/null 2>&1; then fail "a ref with a quote and a semicolon was accepted"; else pass "a ref that the machine's shell could read is refused"; fi

echo "== a quoted argument is one argument, without its quotes =="
QA="z.mjs --settings '{\"ae\":false,\"x\":\"a b\"}' --name \"two words\" --plain v"     # in variables: bash 3.2 miscounts quotes inside $( )
QB="w.mjs --c it's --d plain"
QJ="$("$HERE/launch" --print-checks --check "$QA" --check "$QB" 2>&1)"
if printf '%s' "$QJ" | python3 -c '
import json, sys
c = json.load(sys.stdin)
assert c[0]["args"] == ["--settings", "{\"ae\":false,\"x\":\"a b\"}", "--name", "two words", "--plain", "v"], c[0]["args"]
assert json.loads(c[0]["args"][1]) == {"ae": False, "x": "a b"}
assert c[1]["args"] == ["--c", "it" + chr(39) + "s", "--d", "plain"], c[1]["args"]
'; then pass "a quoted JSON setting and a two-word name arrive whole; a lone apostrophe stays as typed"; else fail "quoted arguments: $QJ"; fi
SC1="$("$HERE/split-checks" ' graphics.mjs ,  movement.mjs --report , ')"
SCIN='a.mjs --q x=1,y=2 ;; b.mjs --s {"k":1,"m":2} ;;'     # in a variable: bash 3.2 misreads ;; inside $( )
SC2="$("$HERE/split-checks" "$SCIN")"
[ "$SC1" = "graphics.mjs
movement.mjs --report" ] && pass "commas separate checks, trimmed, empty ones dropped" || fail "split-checks commas: $SC1"
[ "$SC2" = 'a.mjs --q x=1,y=2
b.mjs --s {"k":1,"m":2}' ] && pass "with a double semicolon as separator, a comma stays inside an argument" || fail "split-checks double semicolon: $SC2"
grep -q 'scripts/aws-gpu/split-checks "\$INPUT_CHECKS"' "$HERE/../../.github/workflows/aws-gpu.yml" && pass "the workflow reads its checks through split-checks" || fail "the workflow does not use split-checks"

echo "== a vCPU limit held by a machine that is shutting down: wait and try again =="
# A fake `aws` on the PATH: the image lookup answers, run-instances refuses twice with VcpuLimitExceeded, then starts.
FA="$(mktemp -d)"
cat > "$FA/aws" <<'FAKE'
#!/usr/bin/env bash
case "$*" in
  *get-parameter*) echo "ami-0123456789abcdef0" ;;
  *run-instances*)
    n=$(cat "$FAKE_COUNT" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$FAKE_COUNT"
    if [ "$n" -le "${FAKE_REFUSE:-2}" ]; then echo "An error occurred (VcpuLimitExceeded) when calling the RunInstances operation: You have requested more vCPU capacity than your current vCPU limit of 8 allows" >&2; exit 254; fi
    echo '{"Instances":[{"InstanceId":"i-0aaaabbbbccccdddd"}]}' ;;
  *) exit 0 ;;
esac
FAKE
chmod +x "$FA/aws"
VO="$(FAKE_COUNT="$FA/count" FAKE_REFUSE=2 AWS_GPU_VCPU_WAIT_SECONDS=0 PATH="$FA:$PATH" "$HERE/launch" --check graphics.mjs 2>&1)"; VC=$?
if [ $VC -eq 0 ] && [ "$(cat "$FA/count")" = "3" ] && echo "$VO" | grep -q '"InstanceId":"i-0aaaabbbbccccdddd"' && echo "$VO" | grep -q "try 2 of"; then pass "refused twice, started on the third try, exit 0"; else fail "vCPU wait: exit $VC, calls $(cat "$FA/count" 2>/dev/null): $(echo "$VO" | tail -2)"; fi
rm -f "$FA/count"
VO="$(FAKE_COUNT="$FA/count" FAKE_REFUSE=99 AWS_GPU_VCPU_WAIT_SECONDS=0 AWS_GPU_VCPU_WAIT_TRIES=3 PATH="$FA:$PATH" "$HERE/launch" --check graphics.mjs 2>&1)"; VC=$?
if [ $VC -ne 0 ] && [ "$(cat "$FA/count")" = "4" ] && echo "$VO" | grep -q "VcpuLimitExceeded"; then pass "still refused after 3 waits: the launch fails and says why"; else fail "vCPU wait must give up: exit $VC, calls $(cat "$FA/count" 2>/dev/null)"; fi
rm -rf "$FA"

echo "== teardown --print assertions =="
TOUT="$("$HERE/teardown" --print 2>&1)"
echo "$TOUT" | grep -qF "Name=tag:project,Values=flyover" && pass "teardown targets only project=flyover" || fail "teardown not scoped to project=flyover"
echo "$TOUT" | grep -qF "terminate-instances" && pass "teardown terminates instances" || fail "teardown does not terminate"
echo "$TOUT" | grep -qi "NOT deleted" && pass "teardown only lists volumes/buckets" || fail "teardown does not make clear volumes are not deleted"

echo "== IAM policy files parse as JSON =="
for p in iam-operator-policy.json iam-instance-policy.json; do
  if python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$HERE/$p" 2>/dev/null; then
    pass "$p is valid JSON"
  elif node -e "JSON.parse(require('fs').readFileSync(process.argv[1]))" "$HERE/$p" 2>/dev/null; then
    pass "$p is valid JSON"
  else
    fail "$p is not valid JSON"
  fi
done

echo
if [ "$FAILED" -eq 0 ]; then
  echo "ALL OFFLINE TESTS PASSED"
else
  echo "OFFLINE TESTS FAILED"
fi
exit "$FAILED"
