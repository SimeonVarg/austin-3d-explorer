# Build-time and documentation material. None of this is fetched by the
# running site: every shots/ and scripts/ mention in js/ is inside a comment.
# Keeping it out of deployments is what stops the 10 GB free tier filling up.

shots/
research/
scripts/
docs/

# Studies: fixtures, benchmark results and prototype builds. Nothing here is fetched by the running
# site. (The one wasm file a page DOES fetch, wasm/meshkernel.wasm behind ?rustbuilder=1, lives in
# wasm/ and is deliberately not listed; scripts/verify/publish-lists.mjs holds both facts.)
experiments/

# Build inputs for the outer-ring bake, not read at runtime.
data/outer/

# Repo housekeeping
.github/
*.md

# Caches and source imagery for the bakes. Verified: every mention of these in
# js/ is inside a comment, nothing fetches them at runtime.
data/imagery_cache/
data/osm_cache/
data/dkr_aerial.png
data/dkr_aerial_geo.png
data/capitol_aerial.png
